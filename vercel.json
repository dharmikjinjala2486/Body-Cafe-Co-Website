{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "BCC_HOSTED_MODE=connected BCC_API_ORIGIN=https://dzsglgcagghinjevdbnw.supabase.co/functions/v1/operations python3 -B deploy/build_netlify.py",
  "outputDirectory": "dist",
  "installCommand": "",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://dzsglgcagghinjevdbnw.supabase.co/functions/v1/operations/api/:path*" },
    { "source": "/feedback", "destination": "/feedback/index.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(self)" }
      ]
    },
    { "source": "/web/b/:file*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/api/:path*", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/ops/:path*", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
